{
  "name": "capri",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "iwsdk dev restart --open --foreground",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/domain --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "fetch:vosk": "node tools/fetch-vosk-model.ts",
    "build:lexicon": "node tools/build-lexicon.ts",
    "voice": "esbuild tools/voice-script/generate-voice-library.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.tmp/voice-script/generate.mjs && node .tmp/voice-script/generate.mjs",
    "audio:report": "esbuild tools/audio-mix/measure-voice.ts tools/audio-mix/render-mix.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outdir=.tmp/audio-mix/bin --out-extension:.js=.mjs && node .tmp/audio-mix/bin/measure-voice.mjs && node .tmp/audio-mix/bin/render-mix.mjs",
    "check": "npm run lint && npm run check:smoke",
    "check:smoke": "esbuild tools/checks/run-checks.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=.tmp/checks/run-checks.mjs && node .tmp/checks/run-checks.mjs",
    "build": "vite build",
    "build:vercel": "npm run typecheck && npm test -- --run && npm run fetch:vosk && npm run build:lexicon && vite build && npm run check",
    "preview": "vite preview"
  },
  "dependencies": {
    "@iwsdk/core": "1.1.0",
    "@pixiv/three-vrm": "3.5.5",
    "@pmndrs/uikit": "^1.0.74",
    "@pmndrs/uikit-horizon": "^1.0.74",
    "@pmndrs/uikit-lucide": "^1.0.74",
    "three": "npm:super-three@0.185.0",
    "vosk-browser": "0.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iwsdk/cli": "1.1.0",
    "@iwsdk/reference": "1.1.0",
    "@iwsdk/vite-plugin-dev": "1.1.0",
    "@meta-quest/metavr": "^1.8.1",
    "@types/three": "^0.185.0",
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.1.4",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "sharp": "0.35.4",
    "three": "npm:super-three@0.185.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}

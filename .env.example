# Development-only placeholders. Copy to `.env` (git-ignored) if you want them.
#
# The product never reads these in a production build. Code may read them only under
# `import.meta.env.DEV`. In the hosted app, credentials are typed on the Setup_Page and are stored
# only on the headset. Vite inlines every VITE_* value, so never put a real secret in a value that
# a production build could read. A build check fails if a value from `.env` appears in `dist/`.

# Home Assistant base URL for local development, https only. Example shape: https://homeassistant.local:8123
VITE_DEV_HA_URL=

# Home Assistant long-lived access token for local development.
VITE_DEV_HA_TOKEN=

<!--
  Hand_Keyboard (task 13.23, Requirement 15.11): a QWERTY key grid opened from the Quick_Actions
  "Keyboard" button. Loaded through PanelUI by src/ui/hand-keyboard.ts. GENERATED SIZES: every button
  has an explicit width and height (36 x 40 keys, 4 gap, 12 padding) because a poke or pinch is
  turned into a key from src/domain/panel-layout.ts, which must agree with this file
  (tests/unit/panel-layout.test.ts checks it). Plain ASCII text only.
-->
<style>
  .root {
    flex-direction: column;
    width: 420px;
  }
  .content {
    flex-direction: column;
    gap: 8px;
    padding: 12px;
  }
  .typed {
    width: 396px;
    height: 44px;
    padding-left: 10px;
    padding-right: 10px;
    justify-content: center;
    background-color: #101216;
    border-radius: 8px;
    color: #fafaf7;
    font-size: 22px;
  }
  .keys {
    flex-direction: column;
    gap: 4px;
  }
  .krow {
    flex-direction: row;
    gap: 4px;
    justify-content: center;
    height: 40px;
  }
  .w36 {
    width: 36px;
    height: 40px;
  }
  .w116 {
    width: 116px;
    height: 40px;
  }
  .w100 {
    width: 100px;
    height: 40px;
  }
  .w172 {
    width: 172px;
    height: 40px;
  }
  .klabel {
    font-size: 18px;
    font-weight: 700;
  }
</style>
<Panel class="root">
  <div class="content">
    <div id="typed" class="typed">_</div>
    <div class="keys">
      <div class="krow">
        <Button id="key-1" class="w36"><ButtonLabel id="key-1-label" class="klabel">1</ButtonLabel></Button>
        <Button id="key-2" class="w36"><ButtonLabel id="key-2-label" class="klabel">2</ButtonLabel></Button>
        <Button id="key-3" class="w36"><ButtonLabel id="key-3-label" class="klabel">3</ButtonLabel></Button>
        <Button id="key-4" class="w36"><ButtonLabel id="key-4-label" class="klabel">4</ButtonLabel></Button>
        <Button id="key-5" class="w36"><ButtonLabel id="key-5-label" class="klabel">5</ButtonLabel></Button>
        <Button id="key-6" class="w36"><ButtonLabel id="key-6-label" class="klabel">6</ButtonLabel></Button>
        <Button id="key-7" class="w36"><ButtonLabel id="key-7-label" class="klabel">7</ButtonLabel></Button>
        <Button id="key-8" class="w36"><ButtonLabel id="key-8-label" class="klabel">8</ButtonLabel></Button>

        <Button id="key-w" class="w36"><ButtonLabel id="key-w-label" class="klabel">w</ButtonLabel></Button>
        <Button id="key-e" class="w36"><ButtonLabel id="key-e-label" class="klabel">e</ButtonLabel></Button>
        <Button id="key-r" class="w36"><ButtonLabel id="key-r-label" class="klabel">r</ButtonLabel></Button>
        <Button id="key-t" class="w36"><ButtonLabel id="key-t-label" class="klabel">t</ButtonLabel></Button>
        <Button id="key-y" class="w36"><ButtonLabel id="key-y-label" class="klabel">y</ButtonLabel></Button>
        <Button id="key-u" class="w36"><ButtonLabel id="key-u-label" class="klabel">u</ButtonLabel></Button>

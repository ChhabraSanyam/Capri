<!--
  Quick_Actions (task 13.23, Requirements 15.10, 15.13): the hand-operated buttons used when the
  microphone is not available, plus the "Keyboard" control that opens the Hand_Keyboard. Loaded
  through PanelUI by src/ui/panels/quick-actions.ts. The header row is always shown (compact form);
  #qa-grid holds the eight actions and is shown when the panel is expanded.
  Every button has an explicit size (156 x 52, 8 gap, 12 padding, 344 wide) because a poke or pinch is
  turned into a button from src/domain/panel-layout.ts, which must agree with this file
  (tests/unit/panel-layout.test.ts checks it). Plain ASCII text only.
-->
<style>
  .root {
    flex-direction: column;
    width: 344px;
  }
  .content {
    flex-direction: column;
    gap: 8px;
    padding: 12px;
  }
  .grid {
    flex-direction: column;
    gap: 8px;
  }
  .row {
    flex-direction: row;
    gap: 8px;
    height: 52px;
  }
  .btn {
    width: 156px;
    height: 52px;
  }
  .label {
    font-size: 18px;
    font-weight: 700;
  }
</style>
<Panel class="root">
  <div class="content">
    <div class="row">
      <Button id="qa-toggle" class="btn"><ButtonLabel id="qa-toggle-label" class="label">Quick actions</ButtonLabel></Button>
      <Button id="qa-keyboard" class="btn"><ButtonLabel id="qa-keyboard-label" class="label">Keyboard</ButtonLabel></Button>
    </div>
    <div id="qa-grid" class="grid">
      <div class="row">
        <Button id="qa-turn_on" class="btn"><ButtonLabel id="qa-turn_on-label" class="label">Turn on</ButtonLabel></Button>
        <Button id="qa-turn_off" class="btn"><ButtonLabel id="qa-turn_off-label" class="label">Turn off</ButtonLabel></Button>
      </div>
      <div class="row">
        <Button id="qa-dim" class="btn"><ButtonLabel id="qa-dim-label" class="label">Dim</ButtonLabel></Button>
        <Button id="qa-brighten" class="btn"><ButtonLabel id="qa-brighten-label" class="label">Brighten</ButtonLabel></Button>
      </div>
      <div class="row">
        <Button id="qa-come_here" class="btn"><ButtonLabel id="qa-come_here-label" class="label">Come here</ButtonLabel></Button>
        <Button id="qa-sit_desk" class="btn"><ButtonLabel id="qa-sit_desk-label" class="label">Sit on the desk</ButtonLabel></Button>
      </div>
      <div class="row">
        <Button id="qa-go_away" class="btn"><ButtonLabel id="qa-go_away-label" class="label">Go away</ButtonLabel></Button>
        <Button id="qa-routine" class="btn"><ButtonLabel id="qa-routine-label" class="label">Run my evening routine</ButtonLabel></Button>
      </div>
    </div>
  </div>
</Panel>
